---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks';

const profile = {
  github: "https://github.com/Dauphinsss",
  linkedin: "https://www.linkedin.com/in/dauphinsss/",
  email: "marcosvelasquezvela123@gmail.com"
};
---

<Layout title="Dauphinsss | Minimal Portfolio">
  <main class="shell">
    <header class="topbar">
      <div class="brand">Dauphinsss</div>
      <div class="controls">
        <button id="lang-toggle" class="control" type="button">EN</button>
        <button id="theme-toggle" class="control" type="button">Auto</button>
      </div>
    </header>

    <section class="hero">
      <p class="label" data-i18n="label">Portfolio</p>
      <h1 data-i18n="name">Marcos Velasquez Vela</h1>
      <p class="subtitle">@Dauphinsss</p>
      <p class="bio" data-i18n="bio">
        Minimal black and white portfolio. Full links and projects coming soon.
      </p>
    </section>

    <section class="grid">
      <article class="card">
        <h2 data-i18n="aboutTitle">About</h2>
        <p data-i18n="aboutText">
          Fullstack developer building clean, useful products with strong visual polish.
        </p>
      </article>

      <article class="card">
        <h2 data-i18n="linksTitle">Links</h2>
        <SocialLinks
          copy={{ github: "GitHub", linkedin: "LinkedIn", email: "Email" }}
          githubUrl={profile.github}
          linkedinUrl={profile.linkedin}
          email={profile.email}
        />
      </article>
    </section>

    <footer class="footer" data-i18n="footer">
      Thanks for stopping by.
    </footer>
  </main>

  <script type="module">
    import { gsap } from "gsap";

    const copy = {
      en: {
        label: "Portfolio",
        name: "Marcos Velasquez Vela",
        bio: "I build modern web products with focus on performance, clean design and real usability.",
        aboutTitle: "About",
        aboutText: "I am Dauphinsss online. I enjoy turning ideas into simple experiences that people actually use.",
        linksTitle: "Links",
        github: "GitHub",
        linkedin: "LinkedIn",
        email: "Email",
        footer: "Thanks for stopping by."
      },
      es: {
        label: "Portafolio",
        name: "Marcos Velasquez Vela",
        bio: "Construyo productos web modernos con foco en rendimiento, diseno limpio y utilidad real.",
        aboutTitle: "Sobre mi",
        aboutText: "En internet soy Dauphinsss. Me gusta convertir ideas en experiencias simples que la gente si usa.",
        linksTitle: "Enlaces",
        github: "GitHub",
        linkedin: "LinkedIn",
        email: "Email",
        footer: "Gracias por pasar por aqui."
      }
    };

    const langButton = document.getElementById("lang-toggle");
    const themeButton = document.getElementById("theme-toggle");
    const root = document.documentElement;

    const savedLang = localStorage.getItem("lang");
    const browserLang = (navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en";
    let currentLang = savedLang === "en" || savedLang === "es" ? savedLang : browserLang;

    const savedTheme = localStorage.getItem("theme");
    let currentTheme =
      savedTheme === "light" || savedTheme === "dark" || savedTheme === "auto" ? savedTheme : "auto";

    function applyLanguage(lang) {
      const dictionary = copy[lang] || copy.en;
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (key && dictionary[key]) el.textContent = dictionary[key];
      });
      root.lang = lang;
      langButton.textContent = lang.toUpperCase();
      localStorage.setItem("lang", lang);
    }

    function resolveTheme(theme) {
      if (theme === "auto") {
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      return theme;
    }

    function applyTheme(theme) {
      const resolved = resolveTheme(theme);
      root.dataset.theme = resolved;
      themeButton.textContent = theme === "auto" ? "Auto" : theme === "dark" ? "Dark" : "Light";
      localStorage.setItem("theme", theme);
    }

    applyLanguage(currentLang);
    applyTheme(currentTheme);

    langButton?.addEventListener("click", () => {
      currentLang = currentLang === "es" ? "en" : "es";
      applyLanguage(currentLang);
    });

    themeButton?.addEventListener("click", () => {
      currentTheme = currentTheme === "auto" ? "light" : currentTheme === "light" ? "dark" : "auto";
      applyTheme(currentTheme);
    });

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      if (currentTheme === "auto") applyTheme("auto");
    });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reducedMotion) {
      gsap.from(".topbar", {
        y: -18,
        autoAlpha: 0,
        duration: 0.55,
        ease: "power2.out"
      });

      gsap.from(".hero > *", {
        y: 18,
        autoAlpha: 0,
        duration: 0.6,
        ease: "power2.out",
        stagger: 0.08,
        delay: 0.1
      });

      gsap.from(".card", {
        y: 20,
        autoAlpha: 0,
        duration: 0.55,
        ease: "power2.out",
        stagger: 0.12,
        delay: 0.25
      });

      gsap.from(".footer", {
        y: 12,
        autoAlpha: 0,
        duration: 0.45,
        ease: "power2.out",
        delay: 0.45
      });
    }
  </script>
</Layout>

<style>
  .shell {
    width: min(860px, 92%);
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.9rem;
  }

  .brand {
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: var(--font-display);
  }

  .controls {
    display: flex;
    gap: 0.55rem;
  }

  .control {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    border-radius: 999px;
    padding: 0.36rem 0.75rem;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .hero {
    padding: 3.2rem 0 2.6rem;
  }

  .label {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.7rem);
    letter-spacing: -0.01em;
    line-height: 0.98;
    font-family: var(--font-display);
  }

  .subtitle {
    margin: 0.6rem 0 1rem;
    font-size: 1rem;
    color: var(--muted);
  }

  .bio {
    margin: 0;
    max-width: 56ch;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .card {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 16px;
    padding: 1.1rem;
  }

  .card h2 {
    margin: 0 0 0.85rem;
    font-size: 1rem;
    font-weight: 570;
  }

  .card p,
  .card li {
    color: var(--muted);
    line-height: 1.55;
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  :global(.social-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.15rem;
    transition: opacity 0.2s ease;
  }

  :global(.social-link:hover) {
    opacity: 0.7;
  }

  .footer {
    margin-top: 1.1rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
