---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Dauphinsss | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Minimal black and white portfolio for Marcos Velasquez Vela (Dauphinsss)."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
